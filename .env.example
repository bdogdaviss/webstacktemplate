# PostgreSQL connection (matches docker-compose.yml host port mapping 5433->5432)
DATABASE_URL=postgresql://postgres:password@localhost:5433/webstackdb

# Redis URL (host port 6380 -> container 6379)
REDIS_URL=redis://localhost:6380

# JWT secret — change for production
JWT_SECRET=super-secret-dev-key

# Application port
PORT=3000

# Environment flag
NODE_ENV=development
